{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "effortLevel": "medium",
  "permissions": {
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "autoMemoryDirectory": "~/workspace/claude-memory",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cfg=\"$(dirname \"$(readlink \"$HOME/.claude/settings.json\")\")\"; for r in \"$cfg\" \"$HOME/workspace/claude-memory\"; do git -C \"$r\" pull --ff-only -q >/dev/null 2>&1; done; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/workspace/claude-memory/sync.sh\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "theme": "dark"
}
