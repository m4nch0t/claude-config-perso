{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cfg=\"$(dirname \"$(readlink \"$HOME/.claude/settings.json\")\")\"; for r in \"$cfg\" \"$HOME/workspace/claude-memory\"; do git -C \"$r\" pull --ff-only -q >/dev/null 2>&1; done; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/workspace/claude-memory/sync.sh\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMemoryDirectory": "~/workspace/claude-memory",
  "theme": "dark"
}
